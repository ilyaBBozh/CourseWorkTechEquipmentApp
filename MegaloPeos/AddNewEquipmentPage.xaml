<Page x:Class="MegaloPeos.AddNewEquipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:MegaloPeos"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddNewEquipmentPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Добавить оборудование" Style="{StaticResource MaterialDesignHeadline6TextBlock}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
        <Button x:Name="btnBack" Grid.Row="0" Grid.Column="1" Content="Назад" Style="{StaticResource MaterialDesignToolButton}" FontSize="20" Width="100" Height="50" HorizontalAlignment="Right" Margin="0, 0, 20, 0" Click="btnBack_Click"/>
        <TextBox Grid.Row="1" Grid.Column="0" x:Name="txtName" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Название" Width="250" Height="50"></TextBox>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtLength" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Длина" Width="250" Height="50"></TextBox>
        <TextBox Grid.Row="2" Grid.Column="0" x:Name="txtHeight" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Высота" Width="250" Height="50"></TextBox>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtWidth" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Ширина" Width="250" Height="50"></TextBox>
        <TextBox Grid.Row="3" Grid.Column="0" x:Name="txtWeight" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Вес" Width="250" Height="50"></TextBox>
        <ComboBox SelectedValuePath="Content" Grid.Row="3" Grid.Column="1" x:Name="cbxEngineer" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="250" Height="50" materialDesign:HintAssist.Hint="Ответственный инженер">
        
        </ComboBox>
        <ComboBox SelectedValuePath="Content" Grid.Row="4" Grid.Column="0" x:Name="cbxStatus" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="250" Height="50" materialDesign:HintAssist.Hint="Статус оборудования">

        </ComboBox>
        <Button x:Name="btnAddEquipment" Foreground="White" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MaterialDesignRaisedButton}" Content="Добавить" Width="150" Click="btnAddEquipment_Click"/>
    </Grid>
</Page>
