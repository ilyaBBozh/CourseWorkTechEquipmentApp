<Page x:Class="MegaloPeos.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MegaloPeos"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Добро пожаловать!" Style="{StaticResource MaterialDesignHeadline4TextBlock}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" x:Name="textLogin" Text="Логин: " VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="25" Margin="70, 0, 0, 0" TextDecorations="Underline"/>
        <TextBlock Grid.Row="2" x:Name="textName" Text="Имя: " VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="25" Margin="70, 0, 0, 0" TextDecorations="Underline"/>
        <TextBlock Grid.Row="3" x:Name="textSecondName" Text="Фамилия: " VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="25" Margin="70, 0, 0, 0" TextDecorations="Underline"/>
        <TextBlock Grid.Row="4" x:Name="textThirdName" Text="Отчество: " VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="25" Margin="70, 0, 0, 0" TextDecorations="Underline"/>
        <TextBlock Grid.Row="5" x:Name="textRole" Text="Роль: " VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="25" Margin="70, 0, 0, 0" TextDecorations="Underline"/>
    </Grid>
</Page>
